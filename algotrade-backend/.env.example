# AlgoTrade Backend Configuration
# Copy this file to .env and adjust values for your environment.

# Server Port (1024 - 65535)
PORT=8080

# Runtime Environment (development | production)
ENV=development

# Cryptographic HMAC-SHA256 Signing Secret (minimum 32 characters)
JWT_SECRET=algotrade-super-secure-production-key-32chars

# Allowed CORS Origin for Next.js Frontend (no trailing slash)
FRONTEND_URL=http://localhost:3000

# Initial Authenticated Trader Account
AUTH_USER_EMAIL=alex.vance@algotrade.com
AUTH_USER_PASSWORD=TradingSecret2026!
AUTH_USER_NAME=Alex Vance
AUTH_USER_ID=usr_982341
AUTH_USER_ROLE=PRO_TRADER

# SQLite Database Location
DATABASE_PATH=data/algotrade.db

# Zerodha Kite Connect Configuration (Get these from https://developers.kite.trade)
KITE_API_KEY=
KITE_API_SECRET=
KITE_REDIRECT_URL=http://localhost:3000/dashboard


RESEND_API_KEY=
REPORT_EMAIL=
